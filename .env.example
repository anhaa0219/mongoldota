# Copy to .env.local and fill in values. Never commit real keys.
# Supabase > Connect > Transaction pooler (port 6543). Server only; used by Drizzle.
DATABASE_URL=
# Hugging Face token with "Make calls to Inference Providers" permission (Draft page screenshot reading).
# Free accounts have no Inference Providers credits: PRO or purchased credits are needed.
HF_API_KEY=
# Optional model overrides (default Qwen/Qwen3.8-27B). Vision = draft screenshots, advice = locked-draft coaching.
HF_VISION_MODEL=
HF_ADVICE_MODEL=
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_INDEX_HOST=

# Steam sign-in: long random string used to sign the session cookie (required in production).
AUTH_SECRET=
# Public URL of the site, e.g. https://mongoldota.com (only needed behind a proxy).
SITE_URL=
# Dev only: 64-bit Steam ID (17 digits) to sign in as without contacting Steam,
# for networks that block steamcommunity.com. Ignored in production.
DEV_STEAM_ID=

# Clerk login (dashboard.clerk.com > API keys). Leave empty in dev to use Clerk's keyless mode.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Live Coach: Supabase Realtime in the browser (Supabase > Project Settings > API). Both are safe to expose:
# RLS lets each signed-in player read only their own rows. Project URL without /rest/v1/.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sentry error and performance monitoring (sentry.io > Settings > Projects > mongoldota > Client Keys (DSN)).
# Public by design: it only lets the app send events. Leave empty to turn Sentry off.
NEXT_PUBLIC_SENTRY_DSN=
# Build time only (Vercel/CI): uploads source maps. Secret. sentry.io > Settings > Auth Tokens > Create organization token.
SENTRY_AUTH_TOKEN=
